---
export interface Props {
  title: string;
  description: string;
  video: string;
  poster?: string;
  start?: number;
}

const { title, description, video, poster, start } = Astro.props;

// Detect YouTube URLs and convert to an embeddable form.
function getYouTubeEmbed(url: string, startSeconds?: number): string | null {
  try {
    const u = new URL(url);
    let id: string | null = null;
    let urlStart: string | null = null;

    if (u.hostname === 'youtu.be') {
      id = u.pathname.replace(/^\//, '');
      urlStart = u.searchParams.get('t') || u.searchParams.get('start');
    } else if (u.hostname.endsWith('youtube.com') || u.hostname.endsWith('youtube-nocookie.com')) {
      if (u.pathname === '/watch') {
        id = u.searchParams.get('v');
      } else if (u.pathname.startsWith('/embed/')) {
        id = u.pathname.split('/embed/')[1];
      } else if (u.pathname.startsWith('/shorts/')) {
        id = u.pathname.split('/shorts/')[1];
      }
      urlStart = u.searchParams.get('t') || u.searchParams.get('start');
    }

    if (!id) return null;

    // Allow `t=525` or `t=8m45s` style values.
    let startNum = startSeconds;
    if (startNum == null && urlStart) {
      const m = urlStart.match(/^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s?)?$/);
      if (m) {
        const h = parseInt(m[1] || '0', 10);
        const min = parseInt(m[2] || '0', 10);
        const s = parseInt(m[3] || '0', 10);
        startNum = h * 3600 + min * 60 + s;
      }
    }

    const params = new URLSearchParams({ rel: '0', enablejsapi: '1' });
    if (startNum && startNum > 0) params.set('start', String(startNum));
    return `https://www.youtube-nocookie.com/embed/${id}?${params.toString()}`;
  } catch {
    return null;
  }
}

const youtubeEmbed = getYouTubeEmbed(video, start);

// Parse timestamps in the description. A "MM:SS - MM:SS" range becomes a
// single chip whose start time is clickable. A standalone timestamp also
// becomes a chip and is clickable. Trailing punctuation like commas is
// kept outside the chip so multiple chips on one line read clearly.
type Part =
  | { type: 'text'; value: string }
  | { type: 'ts'; value: string; seconds: number }
  | { type: 'range'; start: string; end: string; seconds: number };

function tsToSeconds(s: string): number {
  const parts = s.split(':').map((n) => parseInt(n, 10));
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  return parts[0] * 60 + parts[1];
}

function parseTimestamps(text: string): Part[] {
  const parts: Part[] = [];
  const tsPattern = '\\d{1,2}:\\d{2}(?::\\d{2})?';
  const re = new RegExp(`(${tsPattern})\\s*[-\\u2013\\u2014]\\s*(${tsPattern})|(${tsPattern})`, 'g');
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text)) !== null) {
    if (m.index > last) parts.push({ type: 'text', value: text.slice(last, m.index) });
    if (m[1] && m[2]) {
      parts.push({ type: 'range', start: m[1], end: m[2], seconds: tsToSeconds(m[1]) });
    } else if (m[3]) {
      parts.push({ type: 'ts', value: m[3], seconds: tsToSeconds(m[3]) });
    }
    last = m.index + m[0].length;
  }
  if (last < text.length) parts.push({ type: 'text', value: text.slice(last) });
  return parts;
}

const descParts: Part[] = youtubeEmbed
  ? parseTimestamps(description)
  : [{ type: 'text', value: description }];
---

<article class="board-card">
  <div class="video-wrap">
    {youtubeEmbed ? (
      <iframe
        src={youtubeEmbed}
        title={title}
        loading="lazy"
        frameborder="0"
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
        referrerpolicy="strict-origin-when-cross-origin"
        allowfullscreen
      ></iframe>
    ) : (
      <video controls preload="metadata" poster={poster || ''}>
        <source src={video} type="video/mp4">
        Your browser does not support video.
      </video>
    )}
  </div>
  <h3 class="heading">{title}</h3>
  <p>
    {descParts.map((p) => {
      if (p.type === 'text') return <span>{p.value}</span>;
      if (p.type === 'ts') {
        return (
          <span class="ts-chip">
            <button type="button" class="timestamp" data-seconds={p.seconds}>{p.value}</button>
          </span>
        );
      }
      // range
      return (
        <span class="ts-chip">
          <button type="button" class="timestamp" data-seconds={p.seconds}>{p.start}</button>
          <span class="ts-sep">–</span>
          <span class="ts-end">{p.end}</span>
        </span>
      );
    })}
  </p>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.board-card .timestamp').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.board-card');
      const iframe = card?.querySelector<HTMLIFrameElement>('iframe');
      if (!iframe) return;
      const seconds = btn.getAttribute('data-seconds');
      if (!seconds) return;
      try {
        const url = new URL(iframe.src);
        url.searchParams.set('start', seconds);
        url.searchParams.set('autoplay', '1');
        iframe.src = url.toString();
      } catch (e) {
        /* no-op */
      }
    });
  });
</script>

<style>
  .video-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Chip wrapping a timestamp (or range) so each one stands out clearly */
  .ts-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.1rem 0.5rem;
    margin: 0.1rem 0.15rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    font-family: system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
    font-size: 0.85rem;
    line-height: 1.4;
    white-space: nowrap;
    vertical-align: baseline;
    transition: border-color var(--transition), background var(--transition);
  }

  .ts-chip:hover,
  .ts-chip:focus-within {
    border-color: var(--accent);
    background: var(--bg-card);
  }

  .ts-sep {
    color: var(--text-muted);
  }

  .ts-end {
    color: var(--text-muted);
  }

  .timestamp {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: var(--gold);
    cursor: pointer;
    transition: color var(--transition);
  }

  .timestamp:hover,
  .timestamp:focus-visible {
    color: var(--gold-hover);
    outline: none;
  }
</style>
