---
export interface Props {
  title: string;
  description: string;
  video: string;
  poster?: string;
  start?: number;
  lock?: boolean;
}

const { title, description, video, poster, start, lock = false } = Astro.props;

// Detect YouTube URLs and convert to an embeddable form.
function getYouTubeEmbed(url: string, startSeconds?: number): string | null {
  try {
    const u = new URL(url);
    let id: string | null = null;
    let urlStart: string | null = null;

    if (u.hostname === 'youtu.be') {
      id = u.pathname.replace(/^\//, '');
      urlStart = u.searchParams.get('t') || u.searchParams.get('start');
    } else if (u.hostname.endsWith('youtube.com') || u.hostname.endsWith('youtube-nocookie.com')) {
      if (u.pathname === '/watch') {
        id = u.searchParams.get('v');
      } else if (u.pathname.startsWith('/embed/')) {
        id = u.pathname.split('/embed/')[1];
      } else if (u.pathname.startsWith('/shorts/')) {
        id = u.pathname.split('/shorts/')[1];
      }
      urlStart = u.searchParams.get('t') || u.searchParams.get('start');
    }

    if (!id) return null;

    let startNum = startSeconds;
    if (startNum == null && urlStart) {
      const m = urlStart.match(/^(?:(\d+)h)?(?:(\d+)m)?(?:(\d+)s?)?$/);
      if (m) {
        const h = parseInt(m[1] || '0', 10);
        const min = parseInt(m[2] || '0', 10);
        const s = parseInt(m[3] || '0', 10);
        startNum = h * 3600 + min * 60 + s;
      }
    }

    const params = new URLSearchParams({ rel: '0', enablejsapi: '1' });
    if (startNum && startNum > 0) params.set('start', String(startNum));
    return `https://www.youtube-nocookie.com/embed/${id}?${params.toString()}`;
  } catch {
    return null;
  }
}

const youtubeEmbed = getYouTubeEmbed(video, start);

// Parse timestamps in the description for clickable jumps.
type Part =
  | { type: 'text'; value: string }
  | { type: 'ts'; value: string; seconds: number }
  | { type: 'range'; start: string; end: string; seconds: number };

function tsToSeconds(s: string): number {
  const parts = s.split(':').map((n) => parseInt(n, 10));
  if (parts.length === 3) return parts[0] * 3600 + parts[1] * 60 + parts[2];
  return parts[0] * 60 + parts[1];
}

function parseTimestamps(text: string): Part[] {
  const parts: Part[] = [];
  const tsPattern = '\\d{1,2}:\\d{2}(?::\\d{2})?';
  const re = new RegExp(`(${tsPattern})\\s*[-\\u2013\\u2014]\\s*(${tsPattern})|(${tsPattern})`, 'g');
  let last = 0;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text)) !== null) {
    if (m.index > last) parts.push({ type: 'text', value: text.slice(last, m.index) });
    if (m[1] && m[2]) {
      parts.push({ type: 'range', start: m[1], end: m[2], seconds: tsToSeconds(m[1]) });
    } else if (m[3]) {
      parts.push({ type: 'ts', value: m[3], seconds: tsToSeconds(m[3]) });
    }
    last = m.index + m[0].length;
  }
  if (last < text.length) parts.push({ type: 'text', value: text.slice(last) });
  return parts;
}

const descParts: Part[] = youtubeEmbed
  ? parseTimestamps(description)
  : [{ type: 'text', value: description }];
---

<article class={`board-card${lock ? ' is-lockable' : ''}`} data-locked={lock ? 'true' : undefined}>
  {lock && (
    <div class="card-lock" aria-label="Locked content">
      <div class="card-lock-inner">
        <svg class="lock-icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="11" width="16" height="10" rx="2"></rect>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"></path>
        </svg>
        <p class="card-lock-text">This piece is private. Enter the password to view.</p>
        <form class="card-lock-form" autocomplete="off">
          <input type="password" class="card-lock-input" placeholder="Password" required aria-label="Password" />
          <button type="submit" class="btn btn-primary card-lock-submit">Unlock</button>
        </form>
        <p class="card-lock-error error" hidden>Incorrect password.</p>
      </div>
    </div>
  )}

  <div class="card-content" hidden={lock}>
    <div class="video-wrap">
      {youtubeEmbed ? (
        <iframe
          src={youtubeEmbed}
          title={title}
          loading="lazy"
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      ) : (
        <video controls preload="metadata" poster={poster || ''}>
          <source src={video} type="video/mp4">
          Your browser does not support video.
        </video>
      )}
    </div>
    <h3 class="heading">{title}</h3>
    <p>
      {descParts.map((p) => {
        if (p.type === 'text') return <span>{p.value}</span>;
        if (p.type === 'ts') {
          return (
            <button type="button" class="ts-chip timestamp" data-seconds={p.seconds}>{p.value}</button>
          );
        }
        return (
          <button type="button" class="ts-chip timestamp" data-seconds={p.seconds} aria-label={`Jump to ${p.start}`}>
            <span>{p.start}</span>
            <span class="ts-sep">–</span>
            <span class="ts-end">{p.end}</span>
          </button>
        );
      })}
    </p>
  </div>
</article>

<script>
  const SESSION_KEY = 'sarrah_private_auth';
  const PASSWORD_HASH = import.meta.env.PUBLIC_PASSWORD_HASH;

  async function hashPassword(password: string): Promise<string> {
    const encoder = new TextEncoder();
    const data = encoder.encode(password);
    const hashBuffer = await crypto.subtle.digest('SHA-256', data);
    return Array.from(new Uint8Array(hashBuffer))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('');
  }

  function unlockCard(card: Element) {
    card.removeAttribute('data-locked');
    const overlay = card.querySelector<HTMLElement>('.card-lock');
    const content = card.querySelector<HTMLElement>('.card-content');
    if (overlay) overlay.hidden = true;
    if (content) content.hidden = false;
  }

  function unlockAll() {
    document.querySelectorAll('.board-card[data-locked="true"]').forEach(unlockCard);
  }

  // If already authenticated this session, unlock everything immediately.
  if (sessionStorage.getItem(SESSION_KEY) === 'true') {
    unlockAll();
  }

  // Wire up each lock form.
  document.querySelectorAll<HTMLFormElement>('.board-card .card-lock-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const card = form.closest('.board-card');
      if (!card) return;
      const input = form.querySelector<HTMLInputElement>('.card-lock-input');
      const error = card.querySelector<HTMLElement>('.card-lock-error');
      if (!input) return;
      const hash = await hashPassword(input.value);
      if (hash === PASSWORD_HASH) {
        sessionStorage.setItem(SESSION_KEY, 'true');
        unlockAll();
      } else {
        if (error) error.hidden = false;
        input.value = '';
        input.focus();
      }
    });
  });

  // Timestamp click handlers (only meaningful once unlocked).
  document.querySelectorAll<HTMLButtonElement>('.board-card .timestamp').forEach((btn) => {
    btn.addEventListener('click', () => {
      const card = btn.closest('.board-card');
      const iframe = card?.querySelector<HTMLIFrameElement>('iframe');
      if (!iframe) return;
      const seconds = btn.getAttribute('data-seconds');
      if (!seconds) return;
      try {
        const url = new URL(iframe.src);
        url.searchParams.set('start', seconds);
        url.searchParams.set('autoplay', '1');
        iframe.src = url.toString();
      } catch (e) {
        /* no-op */
      }
    });
  });
</script>

<style>
  .video-wrap iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .board-card.is-lockable[data-locked='true'] {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
  }

  .card-lock {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
  }

  .card-lock-inner {
    text-align: center;
    max-width: 320px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .lock-icon {
    color: var(--gold);
  }

  .card-lock-text {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .card-lock-form {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
    align-items: center;
  }

  .card-lock-input {
    width: 100%;
    padding: 0.55rem 0.85rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 1rem;
    text-align: left;
    outline: none;
    transition: border-color var(--transition);
  }

  .card-lock-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-glow);
  }

  .card-lock-submit {
    align-self: stretch;
    justify-content: center;
  }

  .ts-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.1rem 0.5rem;
    margin: 0.1rem 0.15rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    font-family: system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
    font-size: 0.85rem;
    line-height: 1.4;
    white-space: nowrap;
    vertical-align: baseline;
    transition: border-color var(--transition), background var(--transition);
  }

  .ts-chip:hover,
  .ts-chip:focus-within {
    border-color: var(--accent);
    background: var(--bg-card);
  }

  .ts-sep,
  .ts-end {
    color: var(--text-muted);
  }

  .timestamp {
    background: none;
    font: inherit;
    color: var(--gold);
    cursor: pointer;
    transition: color var(--transition);
  }

  .timestamp:hover,
  .timestamp:focus-visible {
    color: var(--gold-hover);
    outline: none;
  }
</style>
